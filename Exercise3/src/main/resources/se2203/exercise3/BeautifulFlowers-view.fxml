<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se2203.exercise3.BeautifulFlowersController">
   <children>
      <TitledPane expanded="false" layoutX="19.0" layoutY="46.0" prefHeight="25.0" prefWidth="144.0" text="About Me">
        <content>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
               <children>
                  <Label layoutX="28.0" layoutY="64.0" text="Name" />
                  <Label layoutX="44.0" layoutY="100.0" text="Email Address" />
               </children>
            </AnchorPane>
        </content>
      </TitledPane>
      <RadioButton fx:id="cannaRadioButton" layoutX="52.0" layoutY="170.0" mnemonicParsing="false" onAction="#cannaRadioButtonListener" text="Canna">
         <toggleGroup>
            <ToggleGroup fx:id="flowersToggleGroup" />
         </toggleGroup></RadioButton>
      <RadioButton fx:id="bleedingHeartRadioButton" layoutX="52.0" layoutY="200.0" mnemonicParsing="false" onAction="#bleedingHeartRadioButtonListener" text="Bleeding Heart" toggleGroup="$flowersToggleGroup" />
      <RadioButton fx:id="cherryBlossomRadioButton" layoutX="52.0" layoutY="230.0" mnemonicParsing="false" onAction="#cherryBlossomRadioButtonListener" text="Cherry Blossom" toggleGroup="$flowersToggleGroup" />
      <RadioButton fx:id="roseRadioButton" layoutX="52.0" layoutY="110.0" mnemonicParsing="false" onAction="#roseRadioButtonListener" selected="true" text="Rose" toggleGroup="$flowersToggleGroup" />
      <RadioButton fx:id="callaLilyRadioButton" layoutX="52.0" layoutY="140.0" mnemonicParsing="false" onAction="#callaLilyRadioButtonListener" text="Calla Lily" toggleGroup="$flowersToggleGroup" />
      <ImageView fx:id="flowersImageView" fitHeight="300.0" fitWidth="300.0" layoutX="175.0" layoutY="46.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Rose.gif" />
         </image>
      </ImageView>
      <Label fx:id="flowersNote" layoutX="489.0" layoutY="46.0" prefHeight="300.0" prefWidth="140.0" text="This beautiful flower and symbol of love belongs the genus Rosa. The family name of this &#10;flower is Rosaceae and it contains different other species in almost all parts of the world. The &#10;flower of rose vary in size from each other depending upon the species to which they belong. A &#10;large number of species of this flower are found in different parts of Asia." wrapText="true">
         <font>
            <Font name="Consolas" size="11.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
